# Orbit environment configuration.
# Copy to `.env` (git-ignored) and adjust as needed. Never commit real secrets.

# ---------------------------------------------------------------------------
# Database (PostgreSQL 16 + pgvector)
# ---------------------------------------------------------------------------
POSTGRES_USER=orbit
POSTGRES_PASSWORD=orbit
POSTGRES_DB=orbit

# ---------------------------------------------------------------------------
# Backend (FastAPI) — variables are read with the APP_ prefix (brand-neutral)
# ---------------------------------------------------------------------------
APP_ENVIRONMENT=development
# SQLAlchemy DSN. Host `db` is the Compose service name; matches POSTGRES_* above.
APP_DATABASE_URL=postgresql+psycopg://orbit:orbit@db:5432/orbit

# ---------------------------------------------------------------------------
# Market data (US-4) — see docs/adr/0011-market-data-provider.md
# ---------------------------------------------------------------------------
# Get a free API key at https://www.tiingo.com (sign up -> API -> Token).
# The free tier allows 50 requests/hour and 1000/day, which is ample because prices
# are cached locally (FR-6). NEVER commit the real key — it belongs in .env only.
APP_MARKET_DATA_PROVIDER=tiingo
APP_MARKET_DATA_API_KEY=
# Hours before cached daily prices are considered stale and re-fetched.
APP_MARKET_DATA_CACHE_TTL_HOURS=24

# ---------------------------------------------------------------------------
# Frontend (Vite) — base URL the browser uses to reach the backend API
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api
# Optional: override the user-facing product name without code changes.
# Backend equivalent is APP_NAME (defaults to "Orbit API").
# VITE_APP_NAME=Orbit
# APP_NAME=Orbit API
