# Orbit production settings — copy to /etc/orbit/orbit.env (root:root, mode 600) and fill in.
# Names only: never commit real values. See docs/operations.md.

# Random, URL-safe (e.g. `openssl rand -hex 24`); the app refuses the development default.
POSTGRES_PASSWORD=

# Market data (Tiingo) and the SEC contact (the project mailbox). Required by the API.
APP_MARKET_DATA_API_KEY=
APP_SEC_CONTACT_EMAIL=

# Grounded questions. Keep Google AI Studio billing disabled (ADR 0022). With Q&A enabled the
# API refuses to start without a key.
APP_QA_ENABLED=true
APP_GEMINI_API_KEY=

# Optional self-hosted answers on the owner's model server (ADR 0029). Leave APP_QA_PROVIDER
# as gemini unless the Spark is reachable over the tailnet from this VM.
# APP_QA_PROVIDER=ollama
# APP_OLLAMA_URL=http://<spark tailnet name>:11434
# APP_OLLAMA_MODEL=qwen3:30b-a3b
# Orbit's own daily limits. Defaults (10 / 20 / 40) protect Gemini's free tier; with the local
# generator they may be raised.
# APP_QA_USER_DAILY=10
# APP_QA_DEPLOYMENT_DAILY=20
# APP_QA_GENERATION_DAILY=40

# Loopback port the web proxy listens on; Tailscale Serve forwards HTTPS to it.
ORBIT_HTTP_PORT=8080
