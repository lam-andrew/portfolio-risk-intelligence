# Orbit production ingress (ADR 0028). Plain HTTP on 8080 inside the VM; Tailscale Serve
# terminates HTTPS in front of it. The admin API is disabled.
{
	admin off
	auto_https off
}

:8080 {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	handle /api/* {
		reverse_proxy api:8000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
